# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_ALLOWED_USER_ID=123456789

# Time & routines
TIMEZONE=Europe/Berlin
MORNING_REVIEW_TIME=07:15
EVENING_REVIEW_TIME=20:30
URGENT_REMINDER_TIMES=09:00,15:00,19:00

# Notion
NOTION_TOKEN=ntn_replace-me
NOTION_DATA_SOURCE_ID=replace-me
NOTION_VERSION=2026-03-11

# OpenAI API (separate billing from a ChatGPT subscription)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=de

# Behavior
DEFAULT_AREA=Sonstiges

# Short-lived per-chat conversation context (no Notion task mirror)
CONVERSATION_DB_PATH=data/conversation.db
CONVERSATION_TTL_MINUTES=20
